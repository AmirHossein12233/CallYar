<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="28sp" android:textStyle="bold" android:gravity="center"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="کاربران آنلاین در مرحله بعد به سرور Render متصل می‌شوند."
        android:gravity="center" android:layout_marginTop="25dp"/>
    <Button android:id="@+id/voiceButton" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="📞 تماس صوتی" android:layout_marginTop="35dp"/>
    <Button android:id="@+id/videoButton" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="📹 تماس تصویری" android:layout_marginTop="12dp"/>
</LinearLayout>
